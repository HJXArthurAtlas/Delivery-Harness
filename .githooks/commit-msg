#!/usr/bin/env bash
# commit-msg 校验：固化格式 `<type>(<scope>): #TECH-<id> <主题>`，默认占位 #TECH-000。
# 激活：git config core.hooksPath .githooks（README「开发」节有说明）。
set -u

msg_file="$1"
subject="$(head -n 1 "$msg_file")"

# Merge / Revert / fixup / squash 等非手写提交放行
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if printf '%s' "$subject" | grep -qE '^[a-z]+(\([a-z0-9-]+\))?: #TECH-[0-9]+ .+'; then
  exit 0
fi

echo "提交信息格式不符：$subject" >&2
echo "要求：<type>(<scope>): #TECH-<id> <主题>；无工作项用默认 #TECH-000。示例：refactor(skills): #TECH-1234 技能更名" >&2
exit 1
